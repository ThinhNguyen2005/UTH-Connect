<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Root Category -->
        <record id="pos_categ_canteen_root" model="pos.category">
            <field name="name">Căn-tin UTH</field>
            <field name="sequence">1</field>
        </record>

        <!-- Sub Categories -->
        <record id="pos_categ_breakfast" model="pos.category">
            <field name="name">Điểm tâm sáng</field>
            <field name="parent_id" ref="pos_categ_canteen_root"/>
            <field name="sequence">2</field>
        </record>

        <record id="pos_categ_lunch" model="pos.category">
            <field name="name">Cơm trưa sinh viên</field>
            <field name="parent_id" ref="pos_categ_canteen_root"/>
            <field name="sequence">3</field>
        </record>

        <record id="pos_categ_drinks" model="pos.category">
            <field name="name">Thức uống &amp; Cà phê</field>
            <field name="parent_id" ref="pos_categ_canteen_root"/>
            <field name="sequence">4</field>
        </record>

        <record id="pos_categ_snacks" model="pos.category">
            <field name="name">Ăn vặt &amp; Tráng miệng</field>
            <field name="parent_id" ref="pos_categ_canteen_root"/>
            <field name="sequence">5</field>
        </record>
    </data>
</odoo>
