<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Tiền mặt -->
        <record id="pos_payment_method_cash" model="pos.payment.method">
            <field name="name">Tiền mặt (Cash)</field>
            <field name="type">cash</field>
        </record>

        <record id="pos_payment_method_cash_drinks" model="pos.payment.method">
            <field name="name">Tiền mặt - Quầy nước</field>
            <field name="type">cash</field>
        </record>

        <record id="pos_payment_method_cash_kiosk" model="pos.payment.method">
            <field name="name">Tiền mặt - Kiosk CS2</field>
            <field name="type">cash</field>
        </record>

        <!-- 2. QR Ngân hàng / VietQR / MoMo -->
        <record id="pos_payment_method_vietqr" model="pos.payment.method">
            <field name="name">Chuyển khoản QR (ghi nhận thủ công)</field>
            <field name="type">bank</field>
        </record>

        <!-- 3. Thẻ sinh viên UTH Smart Card -->
        <record id="pos_payment_method_student_card" model="pos.payment.method">
            <field name="name">Thẻ sinh viên UTH (giả lập)</field>
            <field name="type">bank</field>
        </record>
    </data>
</odoo>
