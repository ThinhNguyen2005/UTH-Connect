<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QWeb PDF Report Template for Canteen Revenue -->
    <template id="report_canteen_revenue_document">
        <t t-call="web.external_layout">
            <div class="page" style="font-family: Arial, sans-serif;">
                <div style="text-align: center; border-bottom: 2px solid #003366; padding-bottom: 10px; margin-bottom: 20px;">
                    <h3 style="color: #003366; margin: 0; text-transform: uppercase;">Trường Đại học Giao thông Vận tải TP.HCM (UTH)</h3>
                    <h4 style="color: #555; margin: 5px 0;">HỆ THỐNG QUẢN LÝ CĂN-TIN SINH VIÊN (ERP)</h4>
                    <h2 style="color: #c0392b; margin: 10px 0 0 0;">BÁO CÁO DOANH THU BÁN HÀNG CĂN-TIN</h2>
                    <p style="margin: 5px 0; color: #777;">
                        <em>Khoảng thời gian: từ ngày <t t-out="doc.date_from"/> đến ngày <t t-out="doc.date_to"/></em>
                    </p>
                </div>

                <t t-set="totals" t-value="doc.get_revenue_totals()"/>
                <table class="table table-sm table-bordered" style="width: 100%; border-collapse: collapse; margin-top: 15px;">
                    <thead style="background-color: #003366; color: white; text-align: center;">
                        <tr>
                            <th style="padding: 8px;">Địa điểm</th>
                            <th style="padding: 8px;">Khung bữa</th>
                            <th style="padding: 8px;">Số đơn</th>
                            <th style="padding: 8px;">Số lượng món</th>
                            <th style="padding: 8px; text-align: right;">Doanh thu (VND)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><t t-out="dict(doc._fields['canteen_location'].selection).get(doc.canteen_location)"/></td>
                            <td><t t-out="dict(doc._fields['meal_type'].selection).get(doc.meal_type)"/></td>
                            <td style="text-align: center;"><t t-out="totals['orders']"/></td>
                            <td style="text-align: center;"><t t-out="totals['quantity']"/></td>
                            <td style="text-align: right; font-weight: bold;"><t t-out="'{:,.2f}'.format(totals['revenue'])"/></td>
                        </tr>
                    </tbody>
                </table>

                <div style="margin-top: 40px; width: 100%;">
                    <div style="float: left; width: 50%; text-align: center;">
                        <p style="font-weight: bold; margin-bottom: 60px;">NGƯỜI LẬP BÁO CÁO</p>
                        <p>(Ký và ghi rõ họ tên)</p>
                    </div>
                    <div style="float: right; width: 50%; text-align: center;">
                        <p style="font-weight: bold; margin-bottom: 60px;">QUẢN LÝ CĂN-TIN UTH</p>
                        <p>(Ký và ghi rõ họ tên)</p>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_canteen_revenue">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="uth_canteen_pos.report_canteen_revenue_document" t-lang="doc.env.user.lang"/>
            </t>
        </t>
    </template>

    <!-- Report Action -->
    <record id="action_report_canteen_revenue" model="ir.actions.report">
        <field name="name">In Báo cáo Doanh thu Căn-tin (PDF)</field>
        <field name="model">canteen.revenue.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">uth_canteen_pos.report_canteen_revenue</field>
        <field name="binding_model_id" ref="model_canteen_revenue_wizard"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
