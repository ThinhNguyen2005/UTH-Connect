rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Danh tính UTH chỉ đến từ ID token do Firebase ký và backend cấp claims.
    function isUthVerified() {
      return isAuthenticated()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.uthVerified == true
        && request.auth.token.email.lower().matches('^[a-z0-9_%+-]([a-z0-9._%+-]{0,62}[a-z0-9_%+-])?@ut[.]edu[.]vn$')
        && !request.auth.token.email.matches('.*[.][.].*');
    }

    function isOwner(userId) {
      return isUthVerified() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isUthVerified() && request.auth.token.role is string && request.auth.token.role.lower() == 'admin';
    }

    function isOrganizer() {
      return isUthVerified() && request.auth.token.role is string && request.auth.token.role.lower() in ['organizer', 'admin'];
    }

    // Hồ sơ riêng: server tạo dữ liệu học tập; client chỉ cập nhật liên hệ của chính mình.
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list, create, delete: if false;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['phoneNumber', 'personalEmail', 'currentAddress'])
        && request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber.size() <= 12
        && (request.resource.data.phoneNumber == ''
          || request.resource.data.phoneNumber.matches('(0[0-9]{9}|[+]84[0-9]{9})'))
        && request.resource.data.personalEmail is string
        && request.resource.data.personalEmail.size() <= 254
        && (request.resource.data.personalEmail == ''
          || request.resource.data.personalEmail.matches("^[^\\s@]+@[^\\s@]+[.][^\\s@]+$"))
        && request.resource.data.currentAddress is string
        && request.resource.data.currentAddress.size() <= 200;
    }

    // --- EVENTS COLLECTION ---
    match /events/{eventId} {
      // Mọi sinh viên đều có thể xem danh sách và chi tiết sự kiện
      allow read: if isAuthenticated();
      // Chỉ Ban tổ chức / Admin mới có quyền tạo và chỉnh sửa sự kiện
      allow create, update, delete: if isOrganizer();

      // Subcollection: Đăng ký tham gia sự kiện
      match /registrations/{userId} {
        allow read: if isOwner(userId) || isOrganizer();
        // Sinh viên chỉ được tạo/huỷ đăng ký của chính mình
        allow create, delete: if isOwner(userId);
        allow update: if isOrganizer();
      }

      // Subcollection: Điểm danh sự kiện (check-in QR code)
      match /attendance/{userId} {
        allow read: if isOwner(userId) || isOrganizer();
        // Chỉ BTC mới có quyền xác nhận điểm danh
        allow write: if isOrganizer();
      }
    }

    // --- NOTIFICATIONS & ANNOUNCEMENTS ---
    match /notifications/{notificationId} {
      // Sinh viên đọc tin tức công khai
      allow read: if isAuthenticated();
      // Chỉ Admin / Cán bộ nhà trường mới được đăng tin
      allow write: if isAdmin();
    }

    // --- SCHEDULES (THỜI KHOÁ BIỂU) ---
    match /schedules/{scheduleId} {
      // Chỉ sinh viên sở hữu thời khoá biểu mới có thể đọc
      allow read: if isUthVerified() && (
        resource.data.studentId == request.auth.token.studentId || 
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // --- GRADES (BẢNG ĐIỂM) ---
    match /grades/{gradeId} {
      // Tuyệt đối bảo mật: chỉ sinh viên sở hữu mới được xem điểm của mình
      allow read: if isUthVerified() && (
        resource.data.studentId == request.auth.token.studentId || 
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );
      // Điểm số chỉ được cập nhật từ hệ thống đào tạo (Admin)
      allow write: if isAdmin();
    }
  }
}
