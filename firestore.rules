rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function isOrganizer() {
      return isAuthenticated() && 
        (isAdmin() || 
         request.auth.token.role == 'organizer' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'organizer');
    }

    function validBookListing() {
      return request.resource.data.keys().hasAll([
          'title', 'subject', 'condition', 'dealType', 'priceVnd', 'description',
          'sellerName', 'contact', 'ownerUid', 'photoUrl', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'title', 'subject', 'condition', 'dealType', 'priceVnd', 'description',
          'sellerName', 'contact', 'ownerUid', 'photoUrl', 'status', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 100
        && request.resource.data.sellerName is string
        && request.resource.data.sellerName.size() > 0
        && request.resource.data.sellerName.size() <= 100
        && request.resource.data.contact is string
        && request.resource.data.contact.size() > 0
        && request.resource.data.contact.size() <= 254
        && (request.resource.data.contact.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
          || (request.resource.data.contact.size() <= 20
            && request.resource.data.contact.matches('^[+() -]*([0-9][+() -]*){8,}[+() -]*$')))
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.dealType in ['SALE', 'EXCHANGE']
        && request.resource.data.condition in ['NEW', 'GOOD', 'USED']
        && request.resource.data.status in ['AVAILABLE', 'SOLD']
        && request.resource.data.createdAt is int
        && (request.resource.data.photoUrl == null || request.resource.data.photoUrl is string)
        && ((request.resource.data.dealType == 'EXCHANGE' && request.resource.data.priceVnd == null)
          || (request.resource.data.dealType == 'SALE'
            && request.resource.data.priceVnd is int && request.resource.data.priceVnd > 0));
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      // Bất kỳ user đã đăng nhập đều có thể đọc profile cơ bản (để hiển thị tên tác giả/bạn học)
      allow read: if isAuthenticated();
      // Chỉ chính user hoặc Admin mới được cập nhật profile cá nhân
      allow write: if isOwner(userId) || isAdmin();
    }

    // --- EVENTS COLLECTION ---
    match /events/{eventId} {
      // Mọi sinh viên đều có thể xem danh sách và chi tiết sự kiện
      allow read: if isAuthenticated();
      // Chỉ Ban tổ chức / Admin mới có quyền tạo và chỉnh sửa sự kiện
      allow create, update, delete: if isOrganizer();

      // Subcollection: Đăng ký tham gia sự kiện
      match /registrations/{userId} {
        allow read: if isAuthenticated();
        // Sinh viên chỉ được tạo/huỷ đăng ký của chính mình
        allow create, delete: if isOwner(userId);
        allow update: if isOrganizer();
      }

      // Subcollection: Điểm danh sự kiện (check-in QR code)
      match /attendance/{userId} {
        allow read: if isOwner(userId) || isOrganizer();
        // Chỉ BTC mới có quyền xác nhận điểm danh
        allow write: if isOrganizer();
      }
    }

    // --- NOTIFICATIONS & ANNOUNCEMENTS ---
    match /notifications/{notificationId} {
      // Sinh viên đọc tin tức công khai
      allow read: if isAuthenticated();
      // Chỉ Admin / Cán bộ nhà trường mới được đăng tin
      allow write: if isAdmin();
    }

    // --- SCHEDULES (THỜI KHOÁ BIỂU) ---
    match /schedules/{scheduleId} {
      // Chỉ sinh viên sở hữu thời khoá biểu mới có thể đọc
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.token.studentId || 
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // --- BOOK MARKETPLACE ---
    match /book_listings/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'AVAILABLE'
        && validBookListing();
      allow update: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && validBookListing();
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    // --- GRADES (BẢNG ĐIỂM) ---
    match /grades/{gradeId} {
      // Tuyệt đối bảo mật: chỉ sinh viên sở hữu mới được xem điểm của mình
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.token.studentId || 
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );
      // Điểm số chỉ được cập nhật từ hệ thống đào tạo (Admin)
      allow write: if isAdmin();
    }
  }
}
